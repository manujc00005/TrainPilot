# ── Server ────────────────────────────────────────────────
PORT=3000
API_KEY=change-me-local-secret

# ── Strava ────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# ── LLM ──────────────────────────────────────────────────
LLM_PROVIDER=claude                  # "claude" | "openai"
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Notifications ─────────────────────────────────────────
NOTIFICATION_PROVIDER=telegram       # "telegram" | "whatsapp"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=

# ── Storage ───────────────────────────────────────────────
STORAGE_BACKEND=sqlite               # "sqlite" | "postgres"
SQLITE_PATH=./data/strava-coach.db

# ── Athlete profile ───────────────────────────────────────
ATHLETE_SPORT=running                # "running" | "cycling" | "triathlon"
ATHLETE_GOAL=Run sub-20 5K by December 2026
ATHLETE_FITNESS_LEVEL=intermediate   # "beginner" | "intermediate" | "advanced"
WEEKLY_TARGET_HOURS=8
