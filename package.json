{
  "name": "strava-coach",
  "version": "0.1.0",
  "description": "Automated training coach powered by Strava + Claude",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "job:onboarding": "tsx scripts/run-job.ts onboarding",
    "job:sync": "tsx scripts/run-job.ts daily-sync",
    "job:analysis": "tsx scripts/run-job.ts daily-analysis",
    "job:planning": "tsx scripts/run-job.ts weekly-planning",
    "job:compliance": "tsx scripts/run-job.ts compliance-check",
    "job:token": "tsx scripts/run-job.ts token-refresh",
    "db:reset-baseline": "tsx scripts/db.ts reset-baseline",
    "db:reset": "tsx scripts/db.ts reset",
    "db:stats": "tsx scripts/db.ts stats",
    "webhook:set": "tsx scripts/telegram-webhook.ts set",
    "webhook:unset": "tsx scripts/telegram-webhook.ts unset",
    "webhook:info": "tsx scripts/telegram-webhook.ts info"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "openai": "^6.34.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.5",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
